
@startuml
title US-37 - Registrera återlämning

skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox

actor Personal
participant "Bokningssystem" as System
participant "ReturnService" as Service
participant "BookingRepository" as Repo

Personal -> System : Ange bokningsnummer
activate System

System -> Service : GetBooking(nummer)
activate Service
Service -> Repo : GetBooking(nummer)
activate Repo
Repo --> Service : Booking / null
deactivate Repo
Service --> System : Booking / null
deactivate Service

alt Bokningen saknas
    System --> Personal : Bokningen hittades inte

else Bokningen finns
    System --> Personal : Visa bokning och status

    alt Status är inte CheckedOut
        System --> Personal : Återlämning nekas

    else Status är CheckedOut
        System --> Personal : Bekräfta återlämning?
        Personal -> System : Ja / Nej

        alt Nej
            System --> Personal : Återlämning avbruten

        else Ja
            System -> Service : RegisterReturn(nummer, tid)
            activate Service

            Service -> Repo : TryRegisterReturn(nummer, tid)
            activate Repo

            alt Ogiltig status
                Repo --> Service : InvalidStatus
                Service --> System : InvalidStatus
                System --> Personal : Återlämning nekas

            else Simulerat lagringsfel
                Repo --> Service : SaveFailed
                Service --> System : SaveFailed
                System --> Personal : Registrering misslyckades

            else Registrering lyckas
                Repo -> Repo : Ändra status och spara tid
                Repo --> Service : Success
                Service --> System : Success
                System --> Personal : Visa bekräftelse
            end

            deactivate Repo
            deactivate Service
        end
    end
end

deactivate System
@enduml

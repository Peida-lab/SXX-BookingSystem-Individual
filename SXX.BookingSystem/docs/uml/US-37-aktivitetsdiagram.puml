
@startuml
title US-37 - Registrera återlämning

skinparam shadowing false

|Personal|
start
:Ange bokningsnummer;

|Bokningssystem|
:Hämta bokning;

if (Finns bokningen?) then (Nej)
    :Visa "Bokningen hittades inte";
    stop
else (Ja)
    :Visa bokningsuppgifter;
endif

if (Status är CheckedOut?) then (Nej)
    :Visa felmeddelande
    för aktuell bokningsstatus;
    stop
else (Ja)
endif

|Personal|
:Bekräfta återlämning
(ja/nej);

|Bokningssystem|
if (Svar är ja eller j?) then (Nej)
    if (Svar är nej eller n?) then (Ja)
        :Visa "Återlämningen avbröts";
    else (Nej)
        :Visa "Ogiltigt svar";
    endif
    stop
else (Ja)
endif

:Hämta aktuell återlämningstid;

|ReturnService|
:Begär registrering av återlämning;

|BookingRepository|
:Kontrollera aktuell bokningsstatus;

if (Status fortfarande CheckedOut?) then (Nej)
    |Bokningssystem|
    :Visa "Återlämningen kan inte registreras";
    stop
else (Ja)
endif

|BookingRepository|
if (Simulerat lagringsfel?) then (Ja)
    |Bokningssystem|
    :Visa "Återlämningen kunde inte sparas";
    stop
else (Nej)
    :Ändra status till Returned och
    registrera återlämningstid;
endif

|Bokningssystem|
:Visa bekräftelse och återlämningstid;

stop
@enduml

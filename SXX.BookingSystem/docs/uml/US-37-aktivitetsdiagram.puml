
@startuml
title US-37 - Registrera återlämning

|Personal|
start
:Sök bokning med bokningsnummer;

|System|
:Hämta bokning;

if (Finns bokningen?) then (Nej)
  :Visa "Bokningen hittades inte";
  stop
else (Ja)
  :Visa bokningsuppgifter;
endif

if (Har bokningen status CheckedOut?) then (Nej)
  :Visa "Uthyrningen är inte påbörjad";
  stop
else (Ja)
  |Personal|
  :Bekräfta återlämning;
endif

|System|
:Registrera återlämningstid;
:Förbered statusändring till Returned;

:Kontrollera aktuell status och
försök spara återlämningen;

if (Är status fortfarande CheckedOut?) then (Nej)
  :Visa "Återlämningen kan inte registreras";
  stop
else (Ja)
endif

if (Lyckades lagringen?) then (Nej)
  :Visa "Återlämningen kunde inte sparas";
  :Behåll tidigare bokningsstatus;
  stop
else (Ja)
  :Spara återlämningstid och
ändra bokningsstatus till Returned;
  :Visa bekräftelse;
endif

stop
@enduml
